# Pick which YAML under config/environments/ to load:
#   local | development | production | bedrock | openai_compatible
# Or add your own: config/environments/myco.yaml → GENELYTICS_ENV=myco
GENELYTICS_ENV=local

# Optional: override path to the config/ directory
# GENELYTICS_CONFIG_DIR=config

# Nested overrides win over YAML (GENELYTICS_<section>__<key>)
# GENELYTICS_LLM__PROVIDER=ollama
# GENELYTICS_LLM__BASE_URL=http://127.0.0.1:11434
# GENELYTICS_LLM__MODEL=mistral
# GENELYTICS_LLM__API_KEY=sk-...
# GENELYTICS_LLM__TEMPERATURE=0
# GENELYTICS_LLM__REGION=us-east-1
# GENELYTICS_LLM__MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# --- OpenAI ---
# GENELYTICS_ENV=production
# GENELYTICS_LLM__API_KEY=sk-...

# --- OpenAI-compatible (Groq / Azure / vLLM / etc.) ---
# GENELYTICS_ENV=openai_compatible
# GENELYTICS_LLM__BASE_URL=https://api.groq.com/openai/v1
# GENELYTICS_LLM__MODEL=llama-3.3-70b-versatile
# GENELYTICS_LLM__API_KEY=gsk-...

# --- AWS Bedrock ---
# GENELYTICS_ENV=bedrock
# GENELYTICS_LLM__REGION=us-east-1
# GENELYTICS_LLM__MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# GENELYTICS_LLM__CREDENTIALS_PROFILE_NAME=default
# or:
# GENELYTICS_LLM__AWS_ACCESS_KEY_ID=...
# GENELYTICS_LLM__AWS_SECRET_ACCESS_KEY=...

# Optional default database URI
# GENELYTICS_DATABASE__URI=mysql+pymysql://root:root@localhost:3305/nasa_space_exploration_database

# Analytics guards
# GENELYTICS_ANALYTICS__MAX_ROWS=100
# GENELYTICS_ANALYTICS__QUERY_TIMEOUT_SECONDS=30
# GENELYTICS_ANALYTICS__READ_ONLY=true
